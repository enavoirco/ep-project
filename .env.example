# GEMINI_API_KEY: Optional for AI Studio runtime
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"

# PORT: Server port (defaults to 3000)
PORT=3000

# Set a unique random value of at least 32 characters.
JWT_SECRET=""

# Used only when creating the initial admin account in a new local database.
ADMIN_EMAIL="admin@bhagyalaxmi.com"
ADMIN_PASSWORD=""

# DATABASE_URL: Optional external PostgreSQL connection string (for Supabase / Cloud SQL)
# When unset, the server uses the built-in high-performance persistent ACID database engine.
DATABASE_URL=""
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
